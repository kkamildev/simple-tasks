{
  "compilerOptions": {
    "target": "es2025",
    "module": "commonjs",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "types": ["node"],
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
